# Modèle de android/keystore.properties (ce dernier est gitignoré, ne jamais le commiter).
# Copier ce fichier en keystore.properties et remplacer les valeurs factices.
# Sans keystore.properties, bundleRelease/assembleRelease sortent un artefact non signé.

# Clé d'upload Play, hors du dépôt. « ~ » est développé ; un chemin relatif part de android/.
storeFile=~/keystores/hibol-minesweeper-upload.jks
storePassword=changeme-store-password
keyAlias=upload
# Même valeur que storePassword si la clé a été créée sans mot de passe distinct (keystore PKCS12).
keyPassword=changeme-key-password
